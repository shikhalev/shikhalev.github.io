<div class="goods-min-grid">
  {%- for product in include.sorted_goods -%}
    {%- assign product_design = site.designs | where: 'path', product.design | first -%}
    {%- assign product_title = product_design.title -%}
    {%- assign product_good = site.goods | where: 'path', product.good | first -%}
    {%- assign product_type = product_good.title -%}
    {%- assign product_shop = product_good.shop -%}
    {%- assign product_recommended = false -%}
    {%- assign product_disabled = false -%}
    {%- if product.recommend == true or product_good.recommend == true or product_design.recommend == true -%}
      {%- assign product_recommended = true -%}
    {%- endif -%}
    {%- if product.disabled == true or product_good.disabled == true or product_design.disabled == true -%}
      {%- assign product_disabled = true -%}
    {%- endif -%}
    {%- unless product_disabled and jekyll.environment == 'production' -%}
      {%- if product_recommended and jekyll.environment != 'production' -%}
        {%- assign recommended_class = ' recommended' -%}
      {%- else -%}
        {%- assign recommended_class = '' -%}
      {%- endif -%}
      {%- if product_disabled -%}
        {%- assign disabled_class = ' disabled' -%}
      {%- else -%}
        {%- assign disabled_class = '' -%}
      {%- endif -%}
    <div class="product-min-card card-back-{{ product_shop }}{{ recommended_class }}{{ disabled_class }}" id="{{ product.digest }}" data-kind="{{ product.good }}" data-design="{{ product.design }}" data-order="{{ product.order }}" >
    <a href="{{ product.url }}" title="Перейти в магазин">
      {%- if product.img -%}
        <img src="{{ product.img }}" alt="{{ product_title | escape }}" loading="lazy">
      {%- else -%}
        <div class="no-photo">Нет фото</div>
      {%- endif -%}
    </a>
    <span class="product-kind {{ product_shop }}"><a title="Перейти к виду товара" href="{{ product_good.url | relative_url }}">{{ product_type }}</a></span>
    <span class="product-design"><a title="Перейти к коллекции" href="{{ product_design.url | relative_url }}">{{ product_title }}</a></span>
    </div>
    {%- endunless -%}
  {%- endfor -%}
</div>
