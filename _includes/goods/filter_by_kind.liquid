{%- if filtered_goods == nil -%}
  {%- assign filtered_goods = "" | split: "," -%}
{%- endif -%}
{%- assign kind = include.kind | default: page -%}
{%- assign current = site.data.flat_goods | where: 'good', kind.path -%}
{%- assign filtered_goods = filtered_goods | concat: current | uniq -%}
{%- if kind.children and kind.children.size > 0 -%}
  {%- for child_path in kind.children -%}
    {%- assign child = site.goods | where: 'path', child_path | first -%}
    {%- if child -%}
      {%- include goods/filter_by_kind.liquid kind=child -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
