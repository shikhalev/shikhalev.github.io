{%- assign has_children = include.kind.children and include.kind.children.size > 0 -%}
{%- assign has_links = include.kind.links and include.kind.links.size > 0 -%}
{%- assign has_any = has_children or has_links -%}
{%- if has_any and include.depth > 0 -%}
  <ul>
  {%- for child_path in include.kind.children -%}
    {%- if child_path == nil or child_path == '' or child_path == 'separator' -%}
      <hr>
    {%- else -%}
      {%- assign child_kind = site.goods | where: 'path', child_path | first -%}
      {%- assign child_url = child_kind.url -%}
      {%- assign child_title = child_kind.title -%}
      {%- if child_kind.shop == 'printdirect' -%}
        {%- assign child_flag = ' • <span class="printdirect">pd</span>' -%}
      {%- elsif child_kind.shop == 'vsemayki' -%}
        {%- assign child_flag = ' • <span class="vsemayki">vm</span>' -%}
      {%- elsif child_kind.shop == 'fun' -%}
        {%- assign child_flag = ' • <span class="fun">fn</span>' -%}
      {%- else -%}
        {%- assign child_flag = '' -%}
      {%- endif -%}
      {%- assign filtered_goods = nil -%}
      {%- include goods/filter_by_kind.liquid kind=child_kind -%}
      {%- unless include.skip_empty and filtered_goods.size == 0 -%}
      <li{% if include.start %} class="start"{% endif %}>
        <p><a href="{{ child_url }}">{{ child_title }} ({{ filtered_goods.size }})</a>{{ child_flag }}</p>
        {%- unless child_kind.no_expand -%}
          {%- assign subdepth = include.depth | minus: 1 -%}
          {%- include goods/subkinds.liquid kind=child_kind skip_empty=include.skip_empty depth=subdepth -%}
        {%- endunless -%}
      </li>
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
  {%- for link_path in include.kind.links -%}
    {%- assign link_kind = site.goods |  where: 'path', link_path | first -%}
    {%- assign link_url = link_kind.url -%}
    {%- assign link_title = link_kind.title -%}
    {%- if link_kind.shop == 'printdirect' -%}
      {%- assign link_flag = ' • <span class="printdirect">pd</span>' -%}
    {%- elsif link_kind.shop == 'vsemayki' -%}
      {%- assign link_flag = ' • <span class="vsemayki">vm</span>' -%}
    {%- elsif link_kind.shop == 'fun' -%}
      {%- assign link_flag = ' • <span class="fun">fn</span>' -%}
    {%- else -%}
      {%- assign link_flag = '' -%}
    {%- endif -%}
    {%- assign filtered_goods = nil -%}
    {%- include goods/filter_by_kind.liquid kind=link_kind -%}
    {%- unless include.skip_empty and filtered_goods.size == 0 -%}
    <li{% if include.start %} class="fa-icon-li-link start"{% else %} class="fa-icon-li-link"{% endif %}>
      <p><a href="{{ link_url }}">{{ link_title }} ({{ filtered_goods.size }})</a>{{ link_flag }}</p>
    </li>
    {%- endunless -%}
  {%- endfor -%}
  </ul>
{%- endif -%}
